  m_text: "\t\t\t\t\t\u041F\u043E\u043A\u0435\u0440: \n\u041A\u043E\u043B\u043E\u0434\u0430:
    52 \u043A\u0430\u0440\u0442\u044B\r\n\u0426\u0435\u043B\u044C: \u0441\u043E\u0431\u0440\u0430\u0442\u044C
    \u043B\u0443\u0447\u0448\u0443\u044E \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u044E
