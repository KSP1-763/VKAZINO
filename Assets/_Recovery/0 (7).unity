  m_text: "\t\t\t\t\t\u0414\u0443\u0440\u0430\u043A:\n\n\u041A\u043E\u043B\u043E\u0434\u0430:
    36 \u043A\u0430\u0440\u0442 (6,7,8,9,10,\u0412,\u0414,\u041A,\u0422)\r\n\u041A\u043E\u0437\u044B\u0440\u044C:
    \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u043A\u0430\u0440\u0442\u0430
    \u0432 \u043A\u043E\u043B\u043E\u0434\u0435\r\n\u041A\u043E\u0437\u044B\u0440\u044C
    \u0431\u044C\u0451\u0442 \u043B\u044E\u0431\u0443\u044E \u043D\u0435 \u043A\u043E\u0437\u044B\u0440\u043D\u0443\u044E
    \u043A\u0430\u0440\u0442\u0443\r\n\u0420\u0430\u0437\u0434\u0430\u0447\u0430:
    \u043F\u043E 6 \u043A\u0430\u0440\u0442 \u043A\u0430\u0436\u0434\u043E\u043C\u0443\r\n\u041F\u0435\u0440\u0432\u044B\u0439
    \u0445\u043E\u0434: \u0443 \u043A\u043E\u0433\u043E \u043C\u043B\u0430\u0434\u0448\u0438\u0439
    \u043A\u043E\u0437\u044B\u0440\u044C\r\n\u0410\u0442\u0430\u043A\u0430: \u0432\u044B\u043B\u043E\u0436\u0438\u0442\u044C
    \u043A\u0430\u0440\u0442\u0443 \u043D\u0430 \u0441\u0442\u043E\u043B\r\n\u0417\u0430\u0449\u0438\u0442\u0430:
    \u043E\u0442\u0431\u0438\u0442\u044C\u0441\u044F \u0441\u0442\u0430\u0440\u0448\u0435\u0439
    \u043A\u0430\u0440\u0442\u043E\u0439 \u0442\u043E\u0439 \u0436\u0435 \u043C\u0430\u0441\u0442\u0438
    \u0438\u043B\u0438 \u043A\u043E\u0437\u044B\u0440\u0435\u043C\r\n\u0415\u0441\u043B\u0438
    \u043D\u0435\u0447\u0435\u043C \u043E\u0442\u0431\u0438\u0442\u044C - \u043A\u0430\u0440\u0442\u044B
    \u0437\u0430\u0431\u0438\u0440\u0430\u044E\u0442\u0441\u044F\r\n\u0412\u044B\u0438\u0433\u0440\u044B\u0432\u0430\u0435\u0442
    \u0442\u043E\u0442, \u043A\u0442\u043E \u043F\u0435\u0440\u0432\u044B\u0439 \u043E\u0441\u0442\u0430\u043B\u0441\u044F
    \u0431\u0435\u0437 \u043A\u0430\u0440\u0442"
  m_isRightToLeft: 0
